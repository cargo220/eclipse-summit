<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tars_tide_layer</name>
  <version>0.1.0</version>
  <description>
    TARS tide-aware costmap layer. Marks water/flood areas as LETHAL_OBSTACLE
    in global_costmap based on real-time tide prediction data from
    /tide/water_polygon_markers (all rings).
  </description>
  <maintainer email="lee@tars.local">lee</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>geometry_msgs</depend>
  <depend>pluginlib</depend>
  <depend>visualization_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_costmap_2d plugin="${prefix}/plugins.xml"/>
  </export>
</package>